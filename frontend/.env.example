# ─────────────────────────────────────────────────────────────────────────────
# EcoCycle Frontend — Environment Variables Template
#
# Copy this file to .env and fill in real values.
# .env is git-ignored. NEVER commit real secrets or production keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Geoapify Geocoding API ────────────────────────────────────────────────────
#
# EcoCycle uses Geoapify to resolve coordinates for customer pickup addresses
# and recycling facility depots, and to generate geographic datasets for R analytics.
#
# Obtain a free API key at: https://www.geoapify.com/
#
# BROWSER CLIENT SECURITY NOTICE:
#   Because this is a Vite client-side SPA, any variable prefixed with `VITE_`
#   is embedded into the browser's JavaScript bundle and can be read by clients.
#   To prevent unauthorized quota consumption:
#     1. In your Geoapify Project Dashboard, configure HTTP Referrer (Origin)
#        restrictions allowing only your authorized domains:
#          - http://localhost:5173/* (Vite Dev Server)
#          - http://localhost:4173/* (Vite Preview Server)
#          - https://your-production-domain.com/*
#     2. In Phase 2, the upcoming Node.js backend will proxy geocoding requests
#        server-side, keeping the key completely private.
#
# NOTE: If this key is left blank or unconfigured, EcoCycle degrades gracefully:
#       all customer and centre workflows proceed normally with manual addresses.
#
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here

# ── FUTURE: Oracle Database & Backend Integration (Phase 2) ───────────────────
# When the Node.js/Express backend is launched, the frontend will connect via:
#
# VITE_API_BASE_URL=http://localhost:5000/api
#
# Server-only variables (ORACLE_USER, ORACLE_PASSWORD, JWT_SECRET, etc.)
# will live exclusively in backend/.env, NOT in this frontend file.
# ─────────────────────────────────────────────────────────────────────────────
