# ─────────────────────────────────────────────────────────────────────────────
# EcoCycle Backend — Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to `.env`:
#      cp .env.example .env
# 2. Restrict file permissions on Linux/macOS:
#      chmod 600 .env
# 3. Fill in your dedicated application database user credentials.
#
# SECURITY NOTICES:
# - NEVER commit `.env` to version control (verified git-ignored).
# - NEVER run the application using MySQL `root`.
# - Use a dedicated application user (e.g. `ecocycle_app`) with least-privilege
#   access to the `ecocycle` database only.
# ─────────────────────────────────────────────────────────────────────────────

# Server Configuration
NODE_ENV=development
PORT=5000

# Client / CORS Configuration (comma-separated origins allowed if multiple)
CORS_ORIGIN=http://localhost:5173

# MySQL Database Configuration
# MySQL MUST be bound to 127.0.0.1 / localhost (never exposed publicly).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecocycle

# Application Database User (DO NOT use 'root')
# Create this user in MySQL using the instructions provided in the project documentation:
#   CREATE USER 'ecocycle_app'@'localhost' IDENTIFIED BY 'YOUR_STRONG_PASSWORD';
#   GRANT ALL PRIVILEGES ON ecocycle.* TO 'ecocycle_app'@'localhost';
#   FLUSH PRIVILEGES;
DB_USER=ecocycle_app
DB_PASSWORD=your_secure_password_here

# Connection Pool Settings
DB_CONNECTION_LIMIT=10
DB_WAIT_FOR_CONNECTIONS=true
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=5000

# JWT Authentication Settings
JWT_SECRET=your_jwt_secret_change_me_to_a_secure_random_string_in_production
JWT_EXPIRES_IN=7d
